export JWT_SECRET_BASE64="$(openssl rand -base64 32 | tr -d '\n')"
echo $JWT_SECRET_BASE64
export JWT_ACCESS_TOKEN_EXPIRATION_MS="900000"

export APP_BOOTSTRAP_RUNNER_ENABLED="true"
export APP_BOOTSTRAP_PERMISSIONS_ENABLED="true"
export APP_BOOTSTRAP_ADMIN_ENABLED="true"

export BOOTSTRAP_ADMIN_USERNAME="superadmin"
export BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
read -r "BOOTSTRAP_ADMIN_PHONE_NUMBER?Admin phone number: "
export BOOTSTRAP_ADMIN_PHONE_NUMBER
read -rs "BOOTSTRAP_ADMIN_PASSWORD?Admin password: "
print
export BOOTSTRAP_ADMIN_PASSWORD


